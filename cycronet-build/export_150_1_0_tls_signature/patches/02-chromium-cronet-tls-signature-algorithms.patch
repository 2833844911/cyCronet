+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_CRONET_TLS_SIGNATURE_ALGORITHM_MAPPER_H_
+#define COMPONENTS_CRONET_TLS_SIGNATURE_ALGORITHM_MAPPER_H_
+
+#include <stdint.h>
+
+#include <string>
+#include <vector>
+
+namespace cronet {
+
+// Maps TLS SignatureScheme names or hex values to their numeric IDs.
+class TLSSignatureAlgorithmMapper {
+ public:
+  // Converts a signature algorithm name or value to its numeric ID.
+  // Supports BoringSSL names such as "rsa_pss_rsae_sha256", raw hex values
+  // such as "0x0904", and packet-dump labels such as "Unknown(0x0904)".
+  // Returns 0 if the value is not recognized or not parseable.
+  static uint16_t NameToId(const std::string& name);
+
+  // Converts a list of signature algorithm names or values to numeric IDs.
+  // Unrecognized values are skipped.
+  static std::vector<uint16_t> NamesToIds(
+      const std::vector<std::string>& names);
+};
+
+}  // namespace cronet
+
+#endif  // COMPONENTS_CRONET_TLS_SIGNATURE_ALGORITHM_MAPPER_H_
