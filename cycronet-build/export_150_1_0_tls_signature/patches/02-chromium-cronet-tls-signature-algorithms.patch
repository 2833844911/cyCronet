new file mode 100644
index 0000000000..95993ae0d8
--- /dev/null
+++ b/components/cronet/tls_signature_algorithm_mapper.cc
@@ -0,0 +1,92 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/cronet/tls_signature_algorithm_mapper.h"
+
+#include <map>
+#include <optional>
+#include <string_view>
+
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+
+namespace cronet {
+
+namespace {
+
+const std::map<std::string, uint16_t>& GetSignatureAlgorithmMap() {
+  static const base::NoDestructor<std::map<std::string, uint16_t>>
+      kSignatureAlgorithmMap({
+          {"RSA_PKCS1_SHA256", 0x0401},
+          {"ECDSA_SECP256R1_SHA256", 0x0403},
+          {"ECDSA_SECP384R1_SHA384", 0x0503},
+          {"RSA_PKCS1_SHA384", 0x0501},
+          {"RSA_PKCS1_SHA512", 0x0601},
+          {"RSA_PSS_RSAE_SHA256", 0x0804},
+          {"RSA_PSS_RSAE_SHA384", 0x0805},
+          {"RSA_PSS_RSAE_SHA512", 0x0806},
+          {"ED25519", 0x0807},
+      });
+  return *kSignatureAlgorithmMap;
+}
+
+std::optional<uint16_t> ParseHexSignatureAlgorithm(std::string value) {
+  base::TrimWhitespaceASCII(value, base::TRIM_ALL, &value);
+  value = base::ToUpperASCII(value);
+
+  constexpr std::string_view kUnknownPrefix = "UNKNOWN(";
+  if (base::StartsWith(value, kUnknownPrefix) && base::EndsWith(value, ")")) {
+    value = value.substr(kUnknownPrefix.size(),
+                         value.size() - kUnknownPrefix.size() - 1);
+  }
+
+  if (!base::StartsWith(value, "0X")) {
+    return std::nullopt;
+  }
+
+  unsigned parsed = 0;
+  if (!base::HexStringToUInt(value.substr(2), &parsed) || parsed > 0xffff) {
+    return std::nullopt;
+  }
+  return static_cast<uint16_t>(parsed);
+}
+
+}  // namespace
+
+uint16_t TLSSignatureAlgorithmMapper::NameToId(const std::string& name) {
+  if (std::optional<uint16_t> parsed = ParseHexSignatureAlgorithm(name)) {
+    return *parsed;
+  }
+
+  std::string normalized_name = base::ToUpperASCII(name);
+  base::TrimWhitespaceASCII(normalized_name, base::TRIM_ALL, &normalized_name);
+
+  const auto& map = GetSignatureAlgorithmMap();
+  auto it = map.find(normalized_name);
+  if (it != map.end()) {
+    return it->second;
+  }
+
+  LOG(WARNING) << "Unknown TLS signature algorithm: " << name;
+  return 0;
+}
+
+std::vector<uint16_t> TLSSignatureAlgorithmMapper::NamesToIds(
+    const std::vector<std::string>& names) {
+  std::vector<uint16_t> ids;
+  ids.reserve(names.size());
+
+  for (const auto& name : names) {
+    uint16_t id = NameToId(name);
+    if (id != 0) {
+      ids.push_back(id);
+    }
+  }
+
+  return ids;
+}
+
+}  // namespace cronet
