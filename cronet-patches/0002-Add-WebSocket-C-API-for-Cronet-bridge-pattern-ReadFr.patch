+++ b/components/cronet/native/cronet_websocket.cc
@@ -0,0 +1,435 @@
+// Copyright 2024 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/cronet/native/cronet_websocket.h"
+
+#include <tuple>
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/strings/string_split.h"
+#include "components/cronet/cronet_context.h"
+#include "components/cronet/native/engine.h"
+#include "net/base/io_buffer.h"
+#include "net/base/isolation_info.h"
+#include "net/base/net_errors.h"
+#include "net/cookies/site_for_cookies.h"
+#include "net/http/http_request_headers.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "net/url_request/url_request_context.h"
+#include "net/websockets/websocket_channel.h"
+#include "net/websockets/websocket_frame.h"
+#include "net/websockets/websocket_handshake_request_info.h"
+#include "net/websockets/websocket_handshake_response_info.h"
+#include "url/gurl.h"
+#include "url/origin.h"
+
+namespace cronet {
+
+namespace {
+
+constexpr net::NetworkTrafficAnnotationTag kTrafficAnnotation =
+    net::DefineNetworkTrafficAnnotation("cronet_websocket", R"(
+    semantics {
+      sender: "Cronet WebSocket"
+      description: "WebSocket connection initiated through Cronet C API."
+      trigger: "Application calls Cronet_WebSocket_Connect."
+      data: "Application-defined WebSocket messages."
+      destination: OTHER
+      destination_other: "Application-specified WebSocket server."
+    }
+    policy {
+      cookies_allowed: NO
+      setting: "Controlled by the application."
+    })");
+
+}  // namespace
+
+// =============================================================================
+// WebSocketEventBridge
+// =============================================================================
+
+WebSocketEventBridge::WebSocketEventBridge(CronetWebSocket* owner)
+    : owner_(owner) {}
+
+WebSocketEventBridge::~WebSocketEventBridge() = default;
+
+void WebSocketEventBridge::Detach() {
+  owner_ = nullptr;
+}
+
+void WebSocketEventBridge::OnCreateURLRequest(net::URLRequest* request) {}
+
+int WebSocketEventBridge::OnURLRequestConnected(
+    net::URLRequest* request,
+    const net::TransportInfo& info,
+    net::CompletionOnceCallback callback) {
+  return net::OK;
+}
+
+void WebSocketEventBridge::OnAddChannelResponse(
+    std::unique_ptr<net::WebSocketHandshakeResponseInfo> response,
+    const std::string& selected_subprotocol,
+    const std::string& extensions) {
+  if (owner_) {
+    owner_->OnOpen(selected_subprotocol);
+  }
+}
+
+void WebSocketEventBridge::OnDataFrame(
+    bool fin,
+    WebSocketMessageType type,
+    base::span<const char> payload) {
+  if (owner_) {
+    owner_->OnMessage(fin, type, payload);
+  }
+}
+
+bool WebSocketEventBridge::HasPendingDataFrames() {
+  return false;
+}
+
+void WebSocketEventBridge::OnSendDataFrameDone() {}
+
+void WebSocketEventBridge::OnClosingHandshake() {}
+
+void WebSocketEventBridge::OnDropChannel(bool was_clean,
+                                          uint16_t code,
+                                          const std::string& reason) {
+  if (owner_) {
+    owner_->OnClose(was_clean, code, reason);
+  }
+}
+
+void WebSocketEventBridge::OnFailChannel(const std::string& message,
+                                          int net_error,
+                                          std::optional<int> response_code) {
+  if (owner_) {
+    owner_->OnFail(message, net_error);
+  }
+}
+
+void WebSocketEventBridge::OnStartOpeningHandshake(
+    std::unique_ptr<net::WebSocketHandshakeRequestInfo> request) {}
+
+void WebSocketEventBridge::OnSSLCertificateError(
+    std::unique_ptr<SSLErrorCallbacks> ssl_error_callbacks,
+    const GURL& url,
+    int net_error,
+    const net::SSLInfo& ssl_info,
+    bool fatal) {
+  if (owner_) {
+    owner_->OnSSLError(std::move(ssl_error_callbacks), fatal);
+  } else {
+    ssl_error_callbacks->CancelSSLRequest(net_error, &ssl_info);
+  }
+}
+
+int WebSocketEventBridge::OnAuthRequired(
+    const net::AuthChallengeInfo& auth_info,
+    scoped_refptr<net::HttpResponseHeaders> response_headers,
+    const net::IPEndPoint& socket_address,
+    base::OnceCallback<void(const net::AuthCredentials*)> callback,
+    std::optional<net::AuthCredentials>* credentials) {
+  *credentials = std::nullopt;
+  return net::OK;
+}
+
+// =============================================================================
+// CronetWebSocket
+// =============================================================================
+
+CronetWebSocket::CronetWebSocket(Cronet_EngineImpl* engine,
+                                 const Cronet_WebSocket_Callbacks* callbacks,
+                                 void* user_data)
+    : engine_(engine),
+      callbacks_(*callbacks),
+      user_data_(user_data),
+      destroy_done_(base::WaitableEvent::ResetPolicy::MANUAL,
+                    base::WaitableEvent::InitialState::NOT_SIGNALED) {}
+
+CronetWebSocket::~CronetWebSocket() = default;
+
+int CronetWebSocket::Connect(const std::string& url,
+                              const std::string& sub_protocols,
+                              const std::string& origin) {
+  GURL gurl(url);
+  if (!gurl.is_valid() || (!gurl.SchemeIs("ws") && !gurl.SchemeIs("wss"))) {
+    return net::ERR_INVALID_URL;
+  }
+
+  std::vector<std::string> protocols;
+  if (!sub_protocols.empty()) {
+    protocols = base::SplitString(sub_protocols, ",",
+                                  base::TRIM_WHITESPACE,
+                                  base::SPLIT_WANT_NONEMPTY);
+  }
+
+  CronetContext* context = engine_->cronet_url_request_context();
+  if (!context) {
+    return net::ERR_FAILED;
+  }
+
+  context->PostTaskToNetworkThread(
+      FROM_HERE,
+      base::BindOnce(&CronetWebSocket::DoConnect, base::Unretained(this),
+                     url, protocols, origin));
+  return net::OK;
+}
+
+void CronetWebSocket::DoConnect(const std::string& url,
+                                const std::vector<std::string>& protocols,
+                                const std::string& origin) {
+  CronetContext* context = engine_->cronet_url_request_context();
+  net::URLRequestContext* url_request_context =
+      context->GetURLRequestContext();
+
+  // Bridge is owned by the channel (via unique_ptr). We don't own it.
+  auto bridge = std::make_unique<WebSocketEventBridge>(this);
+
+  channel_ = std::make_unique<net::WebSocketChannel>(
+      std::move(bridge), url_request_context);
+
+  GURL gurl(url);
+  url::Origin ws_origin = origin.empty()
+      ? url::Origin::Create(gurl)
+      : url::Origin::Create(GURL(origin));
+
+  net::SiteForCookies site_for_cookies =
+      net::SiteForCookies::FromOrigin(ws_origin);
+
+  net::HttpRequestHeaders headers;
+
+  channel_->SendAddChannelRequest(
+      gurl, protocols, ws_origin, site_for_cookies,
+      net::StorageAccessApiStatus::kNone,
+      net::IsolationInfo::CreateTransient(std::nullopt),
+      headers, kTrafficAnnotation);
+
+  base::AutoLock lock(lock_);
+  connected_ = true;
+}
+
+int CronetWebSocket::Send(Cronet_WebSocket_MessageType type,
+                           const void* data, uint64_t len) {
+  base::AutoLock lock(lock_);
+  if (!connected_ || closing_ || destroyed_) {
+    return net::ERR_FAILED;
+  }
+
+  CronetContext* context = engine_->cronet_url_request_context();
+  if (!context) {
+    return net::ERR_FAILED;
+  }
+
+  auto buffer = base::MakeRefCounted<net::IOBufferWithSize>(len);
+  // SAFETY: caller guarantees |data| has at least |len| bytes.
+  UNSAFE_BUFFERS(memcpy(buffer->data(), data, len));
+
+  net::WebSocketFrameHeader::OpCode opcode =
+      (type == Cronet_WebSocket_MESSAGE_TEXT)
+          ? net::WebSocketFrameHeader::kOpCodeText
+          : net::WebSocketFrameHeader::kOpCodeBinary;
+
+  context->PostTaskToNetworkThread(
+      FROM_HERE,
+      base::BindOnce(
+          [](net::WebSocketChannel* channel,
+             net::WebSocketFrameHeader::OpCode opcode,
+             scoped_refptr<net::IOBuffer> buffer, size_t size) {
+            if (channel) {
+              std::ignore =
+                  channel->SendFrame(/*fin=*/true, opcode, buffer, size);
+            }
+          },
+          channel_.get(), opcode, std::move(buffer),
+          static_cast<size_t>(len)));
+  return net::OK;
+}
+
+int CronetWebSocket::Close(uint16_t code, const std::string& reason) {
+  base::AutoLock lock(lock_);
+  if (!connected_ || closing_ || destroyed_) {
+    return net::ERR_FAILED;
+  }
+  closing_ = true;
+
+  CronetContext* context = engine_->cronet_url_request_context();
+  if (!context) {
+    return net::ERR_FAILED;
+  }
+
+  context->PostTaskToNetworkThread(
+      FROM_HERE,
+      base::BindOnce(
+          [](net::WebSocketChannel* channel, uint16_t code,
+             const std::string& reason) {
+            if (channel) {
+              std::ignore = channel->StartClosingHandshake(code, reason);
+            }
+          },
+          channel_.get(), code, reason));
+  return net::OK;
+}
+
+void CronetWebSocket::Destroy() {
+  {
+    base::AutoLock lock(lock_);
+    if (destroyed_) {
+      return;
+    }
+    destroyed_ = true;
+  }
+
+  CronetContext* context = engine_->cronet_url_request_context();
+  if (context && context->IsOnNetworkThread()) {
+    DoDestroy();
+    delete this;
+    return;
+  }
+
+  if (context) {
+    context->PostTaskToNetworkThread(
+        FROM_HERE,
+        base::BindOnce(&CronetWebSocket::DoDestroy, base::Unretained(this)));
+    // Wait for network thread to finish destroying the channel.
+    destroy_done_.Wait();
+  }
+  delete this;
+}
+
+void CronetWebSocket::DoDestroy() {
+  // Runs on the network thread. Destroy the channel first, which
+  // destroys the bridge. The bridge's destructor is safe since
+  // the bridge never deletes the owner.
+  channel_.reset();
+  destroy_done_.Signal();
+}
+
+// --- Event handlers called by the bridge ---
+
+void CronetWebSocket::OnOpen(const std::string& protocol) {
+  if (callbacks_.on_open) {
+    Cronet_WebSocketPtr handle = reinterpret_cast<Cronet_WebSocketPtr>(this);
+    callbacks_.on_open(handle, user_data_, protocol.c_str());
+  }
+  // Kick off reading from the WebSocket stream.
+  if (channel_) {
+    std::ignore = channel_->ReadFrames();
+  }
+}
+
+void CronetWebSocket::OnMessage(bool fin, int type,
+                                 base::span<const char> payload) {
+  if (type != 0) {
+    current_message_type_ = type;
+    message_buffer_.clear();
+  }
+  message_buffer_.append(payload.data(), payload.size());
+
+  if (fin && callbacks_.on_message) {
+    Cronet_WebSocketPtr handle = reinterpret_cast<Cronet_WebSocketPtr>(this);
+    Cronet_WebSocket_MessageType msg_type =
+        (current_message_type_ == net::WebSocketFrameHeader::kOpCodeText)
+            ? Cronet_WebSocket_MESSAGE_TEXT
+            : Cronet_WebSocket_MESSAGE_BINARY;
+    callbacks_.on_message(handle, user_data_, msg_type,
+                          message_buffer_.data(), message_buffer_.size());
+    message_buffer_.clear();
+  }
+}
+
+void CronetWebSocket::OnClose(bool was_clean, uint16_t code,
+                                const std::string& reason) {
+  {
+    base::AutoLock lock(lock_);
+    connected_ = false;
+  }
+  if (callbacks_.on_close) {
+    Cronet_WebSocketPtr handle = reinterpret_cast<Cronet_WebSocketPtr>(this);
+    callbacks_.on_close(handle, user_data_, was_clean ? 1 : 0, code,
+                        reason.c_str());
+  }
+}
+
+void CronetWebSocket::OnFail(const std::string& message, int net_error) {
+  {
+    base::AutoLock lock(lock_);
+    connected_ = false;
+  }
+  if (callbacks_.on_error) {
+    Cronet_WebSocketPtr handle = reinterpret_cast<Cronet_WebSocketPtr>(this);
+    callbacks_.on_error(handle, user_data_, net_error, message.c_str());
+  }
+}
+
+void CronetWebSocket::OnSSLError(
+    std::unique_ptr<net::WebSocketEventInterface::SSLErrorCallbacks> cbs,
+    bool fatal) {
+  // Accept all certs for now.
+  cbs->ContinueSSLRequest();
+}
+
+}  // namespace cronet
+
+// =============================================================================
+// C API entry points
+// =============================================================================
+
+extern "C" {
+
+Cronet_WebSocketPtr
+Cronet_WebSocket_Create(Cronet_EnginePtr engine,
+                        const Cronet_WebSocket_Callbacks* callbacks,
+                        void* user_data) {
+  if (!engine || !callbacks) {
+    return nullptr;
+  }
+  auto* engine_impl = static_cast<cronet::Cronet_EngineImpl*>(engine);
+  auto* ws = new cronet::CronetWebSocket(engine_impl, callbacks, user_data);
+  return reinterpret_cast<Cronet_WebSocketPtr>(ws);
+}
+
+int Cronet_WebSocket_Connect(Cronet_WebSocketPtr ws,
+                             const char* url,
+                             const char* sub_protocols,
+                             const char* origin) {
+  if (!ws || !url) {
+    return -1;
+  }
+  auto* impl = reinterpret_cast<cronet::CronetWebSocket*>(ws);
+  return impl->Connect(url,
+                       sub_protocols ? sub_protocols : "",
+                       origin ? origin : "");
+}
+
+int Cronet_WebSocket_Send(Cronet_WebSocketPtr ws,
+                          Cronet_WebSocket_MessageType type,
+                          const void* data, uint64_t len) {
+  if (!ws || (!data && len > 0)) {
+    return -1;
+  }
+  auto* impl = reinterpret_cast<cronet::CronetWebSocket*>(ws);
+  return impl->Send(type, data, len);
+}
+
+int Cronet_WebSocket_Close(Cronet_WebSocketPtr ws,
+                           uint16_t code, const char* reason) {
+  if (!ws) {
+    return -1;
+  }
+  auto* impl = reinterpret_cast<cronet::CronetWebSocket*>(ws);
+  return impl->Close(code, reason ? reason : "");
+}
+
+void Cronet_WebSocket_Destroy(Cronet_WebSocketPtr ws) {
+  if (!ws) {
+    return;
+  }
+  auto* impl = reinterpret_cast<cronet::CronetWebSocket*>(ws);
+  impl->Destroy();  // Handles network-thread cleanup, then deletes self.
+}
+
+}  // extern "C"
