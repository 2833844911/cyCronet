+#ifndef COMPONENTS_CRONET_NATIVE_CRONET_WEBSOCKET_H_
+#define COMPONENTS_CRONET_NATIVE_CRONET_WEBSOCKET_H_
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/compiler_specific.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/synchronization/lock.h"
+#include "base/synchronization/waitable_event.h"
+#include "components/cronet/native/include/cronet_websocket_c.h"
+#include "net/websockets/websocket_event_interface.h"
+
+namespace net {
+class WebSocketChannel;
+class URLRequestContext;
+}  // namespace net
+
+namespace cronet {
+
+class CronetContext;
+class Cronet_EngineImpl;
+class CronetWebSocket;
+
+// Bridge class owned by WebSocketChannel via unique_ptr.
+// Forwards events to CronetWebSocket. When CronetWebSocket is destroyed,
+// it sets owner_ to null so the bridge stops forwarding.
+class WebSocketEventBridge : public net::WebSocketEventInterface {
+ public:
+  explicit WebSocketEventBridge(CronetWebSocket* owner);
+  ~WebSocketEventBridge() override;
+
+  void Detach();  // Called by CronetWebSocket before channel destruction.
+
+ private:
+  void OnCreateURLRequest(net::URLRequest* request) override;
+  int OnURLRequestConnected(
+      net::URLRequest* request,
+      const net::TransportInfo& info,
+      net::CompletionOnceCallback callback) override;
+  void OnAddChannelResponse(
+      std::unique_ptr<net::WebSocketHandshakeResponseInfo> response,
+      const std::string& selected_subprotocol,
+      const std::string& extensions) override;
+  void OnDataFrame(bool fin,
+                   WebSocketMessageType type,
+                   base::span<const char> payload) override;
+  bool HasPendingDataFrames() override;
+  void OnSendDataFrameDone() override;
+  void OnClosingHandshake() override;
+  void OnDropChannel(bool was_clean,
+                     uint16_t code,
+                     const std::string& reason) override;
+  void OnFailChannel(const std::string& message,
+                     int net_error,
+                     std::optional<int> response_code) override;
+  void OnStartOpeningHandshake(
+      std::unique_ptr<net::WebSocketHandshakeRequestInfo> request) override;
+  void OnSSLCertificateError(
+      std::unique_ptr<SSLErrorCallbacks> ssl_error_callbacks,
+      const GURL& url,
+      int net_error,
+      const net::SSLInfo& ssl_info,
+      bool fatal) override;
+  int OnAuthRequired(
+      const net::AuthChallengeInfo& auth_info,
+      scoped_refptr<net::HttpResponseHeaders> response_headers,
+      const net::IPEndPoint& socket_address,
+      base::OnceCallback<void(const net::AuthCredentials*)> callback,
+      std::optional<net::AuthCredentials>* credentials) override;
+
+  RAW_PTR_EXCLUSION CronetWebSocket* owner_;  // May become null.
+};
+
+// Internal implementation behind the opaque Cronet_WebSocket handle.
+class CronetWebSocket {
+ public:
+  CronetWebSocket(Cronet_EngineImpl* engine,
+                  const Cronet_WebSocket_Callbacks* callbacks,
+                  void* user_data);
+  ~CronetWebSocket();
+
+  CronetWebSocket(const CronetWebSocket&) = delete;
+  CronetWebSocket& operator=(const CronetWebSocket&) = delete;
+
+  int Connect(const std::string& url,
+              const std::string& sub_protocols,
+              const std::string& origin);
+  int Send(Cronet_WebSocket_MessageType type,
+           const void* data, uint64_t len);
+  int Close(uint16_t code, const std::string& reason);
+  void Destroy();  // Must be called instead of delete.
+
+  // Event handlers called by the bridge on the network thread.
+  void OnOpen(const std::string& protocol);
+  void OnMessage(bool fin, int type, base::span<const char> payload);
+  void OnClose(bool was_clean, uint16_t code, const std::string& reason);
+  void OnFail(const std::string& message, int net_error);
+  void OnSSLError(
+      std::unique_ptr<net::WebSocketEventInterface::SSLErrorCallbacks> cbs,
+      bool fatal);
+
+ private:
+  void DoConnect(const std::string& url,
+                 const std::vector<std::string>& protocols,
+                 const std::string& origin);
+  void DoDestroy();
+
+  raw_ptr<Cronet_EngineImpl> engine_;
+  Cronet_WebSocket_Callbacks callbacks_;
+  RAW_PTR_EXCLUSION void* user_data_;
+
+  // Channel and bridge live on the network thread.
+  // channel_ owns the bridge via unique_ptr<WebSocketEventInterface>.
+  std::unique_ptr<net::WebSocketChannel> channel_;
+
+  // Buffer for assembling fragmented messages.
+  std::string message_buffer_;
+  int current_message_type_ = 0;
+
+  base::Lock lock_;
+  bool connected_ = false;
+  bool closing_ = false;
+  bool destroyed_ = false;
+
+  base::WaitableEvent destroy_done_;
+};
+
+}  // namespace cronet
+
+#endif  // COMPONENTS_CRONET_NATIVE_CRONET_WEBSOCKET_H_
