+
+#include "components/cronet/cronet_ssl_config_service.h"
+
+#include <algorithm>
+#include <utility>
+#include "base/logging.h"
+#include "net/ssl/ssl_config.h"
+
+namespace cronet {
+
+namespace {
+
+// List of all commonly supported cipher suites in Chromium/BoringSSL
+// This is used to compute which cipher suites to disable when custom ones are specified
+const uint16_t kAllKnownCipherSuites[] = {
+    // TLS 1.3 cipher suites
+    0x1301,  // TLS_AES_128_GCM_SHA256
+    0x1302,  // TLS_AES_256_GCM_SHA384
+    0x1303,  // TLS_CHACHA20_POLY1305_SHA256
+
+    // TLS 1.2 ECDHE-ECDSA cipher suites
+    0xc02b,  // TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256
+    0xc02c,  // TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384
+    0xcca9,  // TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256
+    0xc009,  // TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA
+    0xc00a,  // TLS_ECDHE_ECDSA_WITH_AES_256_CBC_SHA
+    0xc023,  // TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA256
+    0xc024,  // TLS_ECDHE_ECDSA_WITH_AES_256_CBC_SHA384
+
+    // TLS 1.2 ECDHE-RSA cipher suites
+    0xc02f,  // TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
+    0xc030,  // TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384
+    0xcca8,  // TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256
+    0xc013,  // TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA
+    0xc014,  // TLS_ECDHE_RSA_WITH_AES_256_CBC_SHA
+    0xc027,  // TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA256
+    0xc028,  // TLS_ECDHE_RSA_WITH_AES_256_CBC_SHA384
+
+    // TLS 1.2 RSA cipher suites
+    0x009c,  // TLS_RSA_WITH_AES_128_GCM_SHA256
+    0x009d,  // TLS_RSA_WITH_AES_256_GCM_SHA384
+    0x002f,  // TLS_RSA_WITH_AES_128_CBC_SHA
+    0x0035,  // TLS_RSA_WITH_AES_256_CBC_SHA
+    0x003c,  // TLS_RSA_WITH_AES_128_CBC_SHA256
+    0x003d,  // TLS_RSA_WITH_AES_256_CBC_SHA256
+
+    // Legacy cipher suites
+    0x000a,  // TLS_RSA_WITH_3DES_EDE_CBC_SHA
+    0xc012,  // TLS_ECDHE_RSA_WITH_3DES_EDE_CBC_SHA
+    0xc008,  // TLS_ECDHE_ECDSA_WITH_3DES_EDE_CBC_SHA
+};
+
+// Converts custom cipher suite IDs to disabled cipher suites.
+// The approach is to disable all cipher suites that are NOT in the custom list.
+std::vector<uint16_t> ComputeDisabledCipherSuites(
+    const std::vector<uint16_t>& custom_cipher_suite_ids) {
+  if (custom_cipher_suite_ids.empty()) {
+    // No custom cipher suites specified, use defaults
+    return {};
+  }
+
+  // Compute disabled cipher suites (all known suites except the custom ones)
+  std::vector<uint16_t> disabled_cipher_suites;
+  for (uint16_t suite_id : kAllKnownCipherSuites) {
+    // Check if this suite is in the custom list
+    bool is_custom = std::find(custom_cipher_suite_ids.begin(),
+                               custom_cipher_suite_ids.end(),
+                               suite_id) != custom_cipher_suite_ids.end();
+    if (!is_custom) {
+      disabled_cipher_suites.push_back(suite_id);
+    }
+  }
+
+  LOG(INFO) << "Custom cipher suites enabled: " << custom_cipher_suite_ids.size()
+            << ", disabled: " << disabled_cipher_suites.size();
+
+  return disabled_cipher_suites;
+}
+
+}  // namespace
+
+CronetSSLConfigService::CronetSSLConfigService(
+    std::vector<uint16_t> custom_cipher_suite_ids,
+    std::vector<net::SSLNamedGroupInfo> custom_named_groups,
+    bool permute_extensions,
+    std::optional<bool> alps_use_new_codepoint) {
+  if (!custom_cipher_suite_ids.empty()) {
+    // Use custom cipher suite order (exact order as specified)
+    config_.custom_cipher_suite_order = custom_cipher_suite_ids;
+    config_.use_custom_cipher_order = true;
+  } else {
+    // Fallback to disabled cipher suites approach
+    config_.disabled_cipher_suites =
+        ComputeDisabledCipherSuites(custom_cipher_suite_ids);
+  }
+
+  if (!custom_named_groups.empty()) {
+    config_.supported_named_groups = std::move(custom_named_groups);
+  }
+
+  config_.permute_extensions = permute_extensions;
+  config_.alps_use_new_codepoint = alps_use_new_codepoint;
+}
+
+CronetSSLConfigService::~CronetSSLConfigService() = default;
+
+net::SSLContextConfig CronetSSLConfigService::GetSSLContextConfig() {
+  return config_;
+}
+
+bool CronetSSLConfigService::CanShareConnectionWithClientCerts(
+    std::string_view hostname) const {
+  return false;
+}
+
+}  // namespace cronet
