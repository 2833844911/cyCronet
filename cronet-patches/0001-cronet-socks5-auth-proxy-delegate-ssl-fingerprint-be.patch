@@ -0,0 +1,86 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "components/cronet/tls_curve_mapper.h"
+
+#include <map>
+
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_util.h"
+#include "third_party/boringssl/src/include/openssl/ssl.h"
+
+namespace cronet {
+
+namespace {
+
+const std::map<std::string, net::SSLNamedGroupInfo>& GetCurveMap() {
+  static const base::NoDestructor<std::map<std::string, net::SSLNamedGroupInfo>>
+      kCurveMap({
+#ifdef SSL_GROUP_X25519_MLKEM768
+          {"X25519MLKEM768", {.group_id = SSL_GROUP_X25519_MLKEM768,
+                               .send_key_share = true}},
+#else
+          {"X25519MLKEM768", {.group_id = 0x11ec,
+                               .send_key_share = true}},
+#endif
+          {"X25519KYBER768", {.group_id = 0x6399,
+                               .send_key_share = true}},
+          {"X25519KYBER768DRAFT00",
+           {.group_id = 0x6399, .send_key_share = true}},
+          {"X25519", {.group_id = SSL_GROUP_X25519, .send_key_share = true}},
+          {"P-256", {.group_id = SSL_GROUP_SECP256R1, .send_key_share = false}},
+          {"SECP256R1",
+           {.group_id = SSL_GROUP_SECP256R1, .send_key_share = false}},
+          {"P-384", {.group_id = SSL_GROUP_SECP384R1, .send_key_share = false}},
+          {"SECP384R1",
+           {.group_id = SSL_GROUP_SECP384R1, .send_key_share = false}},
+      });
+  return *kCurveMap;
+}
+
+}  // namespace
+
+std::optional<net::SSLNamedGroupInfo> TLSCurveMapper::NameToGroupInfo(
+    const std::string& name) {
+  std::string normalized_name = base::ToUpperASCII(name);
+  base::TrimWhitespaceASCII(normalized_name, base::TRIM_ALL, &normalized_name);
+
+  const auto& map = GetCurveMap();
+  auto it = map.find(normalized_name);
+  if (it != map.end()) {
+    return it->second;
+  }
+
+  LOG(WARNING) << "Unknown TLS curve name: " << name;
+  return std::nullopt;
+}
+
+std::vector<net::SSLNamedGroupInfo> TLSCurveMapper::NamesToGroupInfos(
+    const std::vector<std::string>& names) {
+  std::vector<net::SSLNamedGroupInfo> infos;
+  infos.reserve(names.size());
+
+  for (const auto& name : names) {
+    std::optional<net::SSLNamedGroupInfo> info = NameToGroupInfo(name);
+    if (!info.has_value()) {
+      continue;
+    }
+
+    bool duplicate = false;
+    for (const auto& existing : infos) {
+      if (existing.group_id == info->group_id) {
+        duplicate = true;
+        break;
+      }
+    }
+    if (!duplicate) {
+      infos.push_back(*info);
+    }
+  }
+
+  return infos;
+}
+
+}  // namespace cronet
