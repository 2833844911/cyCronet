+      {"TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256", 0xc02b},
+      {"TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384", 0xc02c},
+      {"TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256", 0xcca9},
+      {"TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA", 0xc009},
+      {"TLS_ECDHE_ECDSA_WITH_AES_256_CBC_SHA", 0xc00a},
+      {"TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA256", 0xc023},
+      {"TLS_ECDHE_ECDSA_WITH_AES_256_CBC_SHA384", 0xc024},
+
+      // TLS 1.2 ECDHE-RSA cipher suites
+      {"TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256", 0xc02f},
+      {"TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384", 0xc030},
+      {"TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256", 0xcca8},
+      {"TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA", 0xc013},
+      {"TLS_ECDHE_RSA_WITH_AES_256_CBC_SHA", 0xc014},
+      {"TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA256", 0xc027},
+      {"TLS_ECDHE_RSA_WITH_AES_256_CBC_SHA384", 0xc028},
+
+      // TLS 1.2 RSA cipher suites
+      {"TLS_RSA_WITH_AES_128_GCM_SHA256", 0x009c},
+      {"TLS_RSA_WITH_AES_256_GCM_SHA384", 0x009d},
+      {"TLS_RSA_WITH_AES_128_CBC_SHA", 0x002f},
+      {"TLS_RSA_WITH_AES_256_CBC_SHA", 0x0035},
+      {"TLS_RSA_WITH_AES_128_CBC_SHA256", 0x003c},
+      {"TLS_RSA_WITH_AES_256_CBC_SHA256", 0x003d},
+
+      // Legacy cipher suites (for compatibility)
+      {"TLS_RSA_WITH_3DES_EDE_CBC_SHA", 0x000a},
+      {"TLS_ECDHE_RSA_WITH_3DES_EDE_CBC_SHA", 0xc012},
+      {"TLS_ECDHE_ECDSA_WITH_3DES_EDE_CBC_SHA", 0xc008},
+  });
+  return *kCipherSuiteMap;
+}
+
+}  // namespace
+
+uint16_t TLSCipherSuiteMapper::NameToId(const std::string& name) {
+  // Normalize the name (trim whitespace, convert to uppercase)
+  std::string normalized_name = base::ToUpperASCII(name);
+  base::TrimWhitespaceASCII(normalized_name, base::TRIM_ALL, &normalized_name);
+
+  // Skip GREASE values - they are handled automatically by BoringSSL
+  if (normalized_name == "TLS_GREASE" || normalized_name.find("GREASE") != std::string::npos) {
+    return 0;
+  }
+
+  const auto& map = GetCipherSuiteMap();
+  auto it = map.find(normalized_name);
+  if (it != map.end()) {
+    return it->second;
+  }
+
+  LOG(WARNING) << "Unknown TLS cipher suite name: " << name;
+  return 0;
+}
+
+std::vector<uint16_t> TLSCipherSuiteMapper::NamesToIds(
+    const std::vector<std::string>& names) {
+  std::vector<uint16_t> ids;
+  ids.reserve(names.size());
+
+  for (const auto& name : names) {
+    uint16_t id = NameToId(name);
+    if (id != 0) {
+      ids.push_back(id);
+    }
+  }
+
+  return ids;
+}
+
+}  // namespace cronet
