+// Sets custom TLS cipher suites for the Cronet engine.
+// This must be called before Cronet_Engine_StartWithParams().
+//
+// Parameters:
+//   engine: The Cronet engine instance
+//   cipher_suite_names: Array of cipher suite names (e.g., "TLS_RSA_WITH_AES_128_CBC_SHA")
+//   count: Number of cipher suite names in the array
+//
+// Supported cipher suite names (IANA standard names):
+//   - TLS 1.3: TLS_AES_128_GCM_SHA256, TLS_AES_256_GCM_SHA384, TLS_CHACHA20_POLY1305_SHA256
+//   - ECDHE-ECDSA: TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256, TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384, etc.
+//   - ECDHE-RSA: TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256, TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384, etc.
+//   - RSA: TLS_RSA_WITH_AES_128_GCM_SHA256, TLS_RSA_WITH_AES_256_GCM_SHA384, etc.
+//   - CBC: TLS_RSA_WITH_AES_128_CBC_SHA, TLS_RSA_WITH_AES_256_CBC_SHA, etc.
+//
+// Example:
+//   const char* cipher_suites[] = {
+//       "TLS_AES_128_GCM_SHA256",
+//       "TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256",
+//       "TLS_RSA_WITH_AES_128_CBC_SHA"
+//   };
+//   Cronet_Engine_SetCustomCipherSuites(engine, cipher_suites, 3);
+//
+// Returns:
+//   0 on success, non-zero on error
+CRONET_EXPORT int Cronet_Engine_SetCustomCipherSuites(
+    void* engine,
+    const char* const* cipher_suite_names,
+    size_t count);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif  // COMPONENTS_CRONET_NATIVE_INCLUDE_CRONET_TLS_CONFIG_H_
