+#ifndef COMPONENTS_CRONET_CRONET_SSL_CONFIG_SERVICE_H_
+#define COMPONENTS_CRONET_CRONET_SSL_CONFIG_SERVICE_H_
+
+#include <optional>
+#include <vector>
+#include "net/ssl/ssl_config_service.h"
+
+namespace cronet {
+
+// SSLConfigService implementation for Cronet that supports custom cipher suites.
+class CronetSSLConfigService : public net::SSLConfigService {
+ public:
+  // Creates a new CronetSSLConfigService with optional custom cipher suites and
+  // named groups.
+  CronetSSLConfigService(
+      std::vector<uint16_t> custom_cipher_suite_ids,
+      std::vector<net::SSLNamedGroupInfo> custom_named_groups = {},
+      bool permute_extensions = true,
+      std::optional<bool> alps_use_new_codepoint = std::nullopt);
+
+  CronetSSLConfigService(const CronetSSLConfigService&) = delete;
+  CronetSSLConfigService& operator=(const CronetSSLConfigService&) = delete;
+
+  ~CronetSSLConfigService() override;
+
+  // net::SSLConfigService implementation:
+  net::SSLContextConfig GetSSLContextConfig() override;
+  bool CanShareConnectionWithClientCerts(
+      std::string_view hostname) const override;
+
+ private:
+  net::SSLContextConfig config_;
