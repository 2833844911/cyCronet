+std::string CronetProxyDelegate::GetProxyAuthHeaderForHttpProxy() const {
+  // Find the first HTTP proxy with authentication
+  for (int i = 0; i < proxy_options_.proxies_size(); ++i) {
+    const auto& proxy = proxy_options_.proxies(i);
+
+    // Only HTTP proxies (not HTTPS or SOCKS5) need preemptive auth for non-tunnel requests
+    if (proxy.scheme() == cronet::proto::ProxyScheme::HTTP &&
+        proxy.has_username() && proxy.has_password() &&
+        !proxy.username().empty()) {
+      // Build Basic auth credentials: base64(username:password)
+      std::string credentials = proxy.username() + ":" + proxy.password();
+      std::string encoded = base::Base64Encode(credentials);
+      return "Basic " + encoded;
+    }
+  }
+  return "";
+}
+
+bool CronetProxyDelegate::GetSocksAuthCredentials(
+    const net::ProxyChain& proxy_chain,
+    std::string* username,
+    std::string* password) {
+  if (!proxy_chain.opaque_data().has_value())
+    return false;
+
+  int chain_id = *proxy_chain.opaque_data();
+  if (chain_id < 0 || chain_id >= proxy_options_.proxies_size())
+    return false;
+
+  const auto& proxy = proxy_options_.proxies(chain_id);
+  if (proxy.scheme() != cronet::proto::ProxyScheme::SOCKS5)
+    return false;
+
+  if (!proxy.has_username() || !proxy.has_password() ||
+      proxy.username().empty()) {
+    return false;
+  }
+
+  *username = proxy.username();
+  *password = proxy.password();
+  return true;
+}
+
 }  // namespace cronet
